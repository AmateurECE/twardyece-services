upstream cimmeria {
    keepalive 32;
    server public_cimmeria:3000;
}

server {
    if ($host = conan.ethantwardy.com) {
        return 301 https://$host$request_uri;
    }

    server_name = conan.ethantwardy.com;
    listen 80;
    return 404;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name conan.ethantwardy.com;

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://cimmeria;
        proxy_redirect http://cimmeria https://conan.ethantwardy.com;
    }
}
